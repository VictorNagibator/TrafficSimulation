<Window x:Class="TrafficSimulation.RoadSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TrafficSimulation"
        mc:Ignorable="d"
        Title="Настройки дороги" Height="350" Width="550">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="10">
            <TextBlock x:Name="RoadNameTextBlock" Text="Название дороги: " VerticalAlignment="Center" Margin="10"/>
            <TextBox x:Name="RoadNameTextBox" Height="20" Margin="5" VerticalAlignment="Center" Width="150" TextChanged="RoadNameTextBox_TextChanged"/>
            <Button x:Name="DeleteRoadButton" Content="🗑" Margin="10" HorizontalAlignment="Right" Click="DeleteRoadButton_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="10">
            <TextBlock x:Name="MaxSpeedTextBlock" Text="Максимально разрешенная скорость (км/ч): " Margin="10,0,0,0" VerticalAlignment="Center"/>
            <Slider x:Name="MaxSpeedSlider" Minimum="20" Maximum="100" Margin="10" Width="198" ValueChanged="MaxSpeedSlider_ValueChanged"/>
            <TextBlock x:Name="MaxSpeedValue" VerticalAlignment="Center" Margin="10,0,0,0" Text="{Binding ElementName=MaxSpeedSlider, Path=Value, StringFormat=F0}" Width="20"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Vertical" Margin="10">
            <TextBlock Text="Параметры дороги" FontWeight="Bold" HorizontalAlignment="Center" Margin="10"/>
            <RadioButton x:Name="OneWayRadioButton" Content="Одностороннее движение" HorizontalAlignment="Left" Margin="10" Checked="OneWayRadioButton_Checked"/>
            <RadioButton x:Name="TwoWayRadioButton" Content="Двухстороннее движение" HorizontalAlignment="Left" Margin="10" Checked="TwoWayRadioButton_Checked"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" Margin="10" Grid.RowSpan="2">
            <TextBlock x:Name="NumOfLanesTextBlock" Text="Количество полос (в каждую сторону): " Margin="10,0,0,0" VerticalAlignment="Center"/>
            <Slider x:Name="NumOfLanesSlider" Minimum="1" Maximum="10" Margin="10" Width="200" ValueChanged="NumOfLanesSlider_ValueChanged"/>
            <TextBlock x:Name="NumOfLanesValue" VerticalAlignment="Center" Margin="10,0,0,0" Text="{Binding ElementName=NumOfLanesSlider, Path=Value, StringFormat=F0}" Width="18"/>
        </StackPanel>
    </Grid>
</Window>
