<Window x:Class="TrafficSimulation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:gif="http://wpfanimatedgif.codeplex.com"
        xmlns:local="clr-namespace:TrafficSimulation"
        mc:Ignorable="d"
        Title="TrafficSimulator" Height="800" Width="1200" WindowStartupLocation="CenterScreen" WindowState="Maximized" Icon="Media/mainIcon.png">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <Button x:Name="CitySettingsButton" Content="Настройки города" Click="CitySettingsButton_Click" Margin="75,0,50,0" Width="140"/>
            <Button x:Name="StartSimulationButton" Content="Запустить симуляцию" Click="StartSimulationButton_Click" Margin="75,0,50,0" Width="140"/>
            <Button x:Name="StopSimulationButton" Content="Остановить симуляцию" Click="StopSimulationButton_Click" Margin="75,0,50,0" Visibility="Collapsed" Width="140"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10">
            <Button x:Name="AddVehicleButton" Content="Добавить автомобиль" Click="AddVehicleButton_Click" Margin="75,0,50,0" Width="140"/>
            <Button x:Name="DeleteAllVehiclesButton" Content="Удалить все автомобили" Click="DeleteAllVehiclesButton_Click" Margin="75,0,50,0" Width="140"/>
            <Button x:Name="AddRoadButton" Content="Добавить дорогу" Click="AddRoadButton_Click" Margin="75,0,50,0" Width="140"/>
            <Button x:Name="CancelAddRoadButton" Content="Отмена" Click="CancelAddRoadButton_Click" Margin="75,0,50,0" Visibility="Collapsed" Width="140"/>
        </StackPanel>

        <Canvas Name="CityCanvas" Grid.Row="2" Grid.Column="0" Background="LightGray" Margin="10,10,10,10" 
        SizeChanged="CityCanvas_SizeChanged" MouseWheel="CityCanvas_MouseWheel"
        MouseLeftButtonDown="CityCanvas_LeftMouseDown" MouseMove="CityCanvas_MouseMove" MouseUp="CityCanvas_MouseUp"/>

        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Image x:Name="RainGIF" gif:ImageBehavior.AnimatedSource="Media/clouds-raining.gif" ToolTip="Сейчас идет дождь. Машины передвигаются медленнее и с большей вероятностью попадут в ДТП." Height="80" Width="90" VerticalAlignment="Top" Visibility="Hidden" Margin="0,0,0,15"/>
            <Button Content="↺" Click="ResetButton_Click" Width="30" Height="30" Margin="5"/>
            <Button Content="+" Click="ZoomInButton_Click" Width="30" Height="30" Margin="5"/>
            <Button Content="-" Click="ZoomOutButton_Click" Width="30" Height="30" Margin="5"/>
            <Button Click="TrafficJamButton_Click" Width="50" Height="50" Margin="5,25,5,5" ToolTip="Пробки">
                <Image Source="Media/TrafficButtonIcon.png"/>
            </Button>
        </StackPanel>
    </Grid>
</Window>