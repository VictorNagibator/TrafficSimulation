<Window x:Class="TrafficSimulation.App.CitySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TrafficSimulation.App"
        mc:Ignorable="d"
        Title="City settings" Height="450" Width="620" Icon="Media/cityIcon.png" ResizeMode="CanMinimize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Left" Orientation="Horizontal" Margin="10">
            <TextBlock Text="City wide speed limit (km/h):" VerticalAlignment="Center" Margin="10"/>
            <Slider x:Name="MaxSpeedSlider" Minimum="20" Maximum="100" Margin="5" Width="198" VerticalAlignment="Center" ValueChanged="MaxSpeedSlider_ValueChanged"/>
            <TextBlock x:Name="MaxSpeedValue" Margin="10,0,0,0" Text="{Binding ElementName=MaxSpeedSlider, Path=Value, StringFormat=F0}" Width="20" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="1" HorizontalAlignment="Left" Orientation="Horizontal" Margin="10">
            <TextBlock Text="Road quality (%):" VerticalAlignment="Center" Margin="10"/>
            <Slider x:Name="RoadQualitySlider" Minimum="5" Maximum="100" Margin="5" Width="198" VerticalAlignment="Center" ValueChanged="RoadQualitySlider_ValueChanged"/>
            <TextBlock x:Name="RoadQualityValue" Margin="10,0,0,0" Text="{Binding ElementName=RoadQualitySlider, Path=Value, StringFormat=F0}" Width="20" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="2" HorizontalAlignment="Left" Orientation="Horizontal" Margin="10">
            <TextBlock Text="Chance of an accident or breakdown (%):" VerticalAlignment="Center" Margin="10"/>
            <Slider x:Name="AccidentChanceSlider" Minimum="0" Maximum="20" Margin="5" Width="198" VerticalAlignment="Center" ValueChanged="AccidentChanceSlider_ValueChanged"/>
            <TextBlock x:Name="AccidentChanceValue" Margin="10,0,0,0" Text="{Binding ElementName=AccidentChanceSlider, Path=Value, StringFormat=F1}" Width="22" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="3" HorizontalAlignment="Left" Orientation="Horizontal" Margin="10">
            <TextBlock Text="Time spent stopped by an accident (s):" VerticalAlignment="Center" Margin="10"/>
            <Slider x:Name="AccidentDurationSlider" Minimum="5" Maximum="300" Margin="5" Width="198" VerticalAlignment="Center" ValueChanged="AccidentDurationSlider_ValueChanged"/>
            <TextBlock x:Name="AccidentDurationValue" Margin="10,0,0,0" Text="{Binding ElementName=AccidentDurationSlider, Path=Value, StringFormat=F0}" Width="22" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="4" HorizontalAlignment="Left" Orientation="Horizontal" Margin="10">
            <TextBlock Text="Chance of rain (%):" VerticalAlignment="Center" Margin="10"/>
            <Slider x:Name="RainChanceSlider" Minimum="0" Maximum="40" Margin="5" Width="198" VerticalAlignment="Center" ValueChanged="RainChanceSlider_ValueChanged"/>
            <TextBlock x:Name="RainChanceValue" Margin="10,0,0,0" Text="{Binding ElementName=RainChanceSlider, Path=Value, StringFormat=F1}" Width="22" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="5" HorizontalAlignment="Left" Orientation="Horizontal" Margin="10">
            <TextBlock Text="Duration of a rain period (s):" VerticalAlignment="Center" Margin="10"/>
            <Slider x:Name="RainDurationSlider" Minimum="10" Maximum="500" Margin="5" Width="198" VerticalAlignment="Center" ValueChanged="RainDurationSlider_ValueChanged"/>
            <TextBlock x:Name="RainDurationValue" Margin="10,0,0,0" Text="{Binding ElementName=RainDurationSlider, Path=Value, StringFormat=F0}" Width="22" VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
