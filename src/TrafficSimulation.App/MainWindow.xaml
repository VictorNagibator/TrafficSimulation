<Window x:Class="TrafficSimulation.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:gif="http://wpfanimatedgif.codeplex.com"
        xmlns:local="clr-namespace:TrafficSimulation.App"
        mc:Ignorable="d"
        Title="Traffic Simulator" Height="800" Width="1200" WindowStartupLocation="CenterScreen" WindowState="Maximized" Icon="Media/mainIcon.png">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Simulation and city wide settings. -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <Button x:Name="CitySettingsButton" Content="City settings" Click="CitySettingsButton_Click" Margin="75,0,50,0" Width="140"/>
            <Button x:Name="StartSimulationButton" Content="Start simulation" Click="StartSimulationButton_Click" Margin="75,0,50,0" Width="140"/>
            <Button x:Name="StopSimulationButton" Content="Stop simulation" Click="StopSimulationButton_Click" Margin="75,0,50,0" Visibility="Collapsed" Width="140"/>
        </StackPanel>

        <!-- Map editing. -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10">
            <Button x:Name="AddVehicleButton" Content="Add vehicle" Click="AddVehicleButton_Click" Margin="75,0,50,0" Width="140"/>
            <Button x:Name="DeleteAllVehiclesButton" Content="Remove all vehicles" Click="DeleteAllVehiclesButton_Click" Margin="75,0,50,0" Width="140"/>
            <Button x:Name="AddRoadButton" Content="Add road" Click="AddRoadButton_Click" Margin="75,0,50,0" Width="140"/>
            <Button x:Name="CancelAddRoadButton" Content="Cancel" Click="CancelAddRoadButton_Click" Margin="75,0,50,0" Visibility="Collapsed" Width="140"/>
            <Button x:Name="ClearAllButton" Content="Clear map" Click="ClearAllButton_Click" Width="140" Margin="75,0,50,0"/>
        </StackPanel>

        <Canvas Name="CityCanvas" Grid.Row="2" Grid.Column="0" Background="LightGray" Margin="10,10,10,10"
        SizeChanged="CityCanvas_SizeChanged" MouseWheel="CityCanvas_MouseWheel"
        MouseLeftButtonDown="CityCanvas_LeftMouseDown" MouseMove="CityCanvas_MouseMove"
        MouseUp="CityCanvas_MouseUp" MouseLeave="CityCanvas_MouseLeave"/>

        <!-- View controls. -->
        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Image x:Name="RainImage" gif:ImageBehavior.AnimatedSource="Media/clouds-raining.gif" ToolTip="It is raining: vehicles drive slower and are more likely to crash." Height="80" Width="90" VerticalAlignment="Top" Visibility="Hidden" Margin="0,0,0,15"/>
            <Button Content="↺" Click="ResetButton_Click" Width="30" Height="30" Margin="5" ToolTip="Reset the view"/>
            <Button Content="+" Click="ZoomInButton_Click" Width="30" Height="30" Margin="5" ToolTip="Zoom in"/>
            <Button Content="-" Click="ZoomOutButton_Click" Width="30" Height="30" Margin="5" ToolTip="Zoom out"/>
            <Button Click="TrafficJamButton_Click" Width="50" Height="50" Margin="5,25,5,5" ToolTip="Show traffic density">
                <Image Source="Media/trafficButtonIcon.png"/>
            </Button>
        </StackPanel>
    </Grid>
</Window>
